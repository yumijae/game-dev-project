; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game-Dev-Project"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/autoloads/event_bus.gd"
TimeManager="*res://core/autoloads/time_manager.gd"
NoiseManager="*res://core/autoloads/noise_manager.gd"
ScentManager="*res://core/autoloads/scent_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="loot"
3d_physics/layer_3="player"
3d_physics/layer_4="doors"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
